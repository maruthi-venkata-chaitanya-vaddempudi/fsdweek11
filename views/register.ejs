<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Registration Form</title>
  <style>
    body { max-width: 560px; margin: 48px auto; padding: 0 24px; color: #1f2937; font: 16px/1.6 system-ui, sans-serif; }
    h1 { color: #163b70; }
    label { display: block; margin: 16px 0; }
    input { display: block; box-sizing: border-box; width: 100%; margin-top: 4px; padding: 10px; border: 1px solid #9ca3af; border-radius: 5px; font: inherit; }
    button { padding: 10px 18px; border: 0; border-radius: 5px; background: #1759a6; color: white; font: inherit; cursor: pointer; }
    .error { color: #b42318; }
    a { color: #1759a6; }
  </style>
</head>
<body>
  <h1>Registration Form</h1>

  <% if (error) { %>
    <p class="error" role="alert"><%= error %></p>
  <% } %>

  <form action="/register" method="POST">
    <label>Name
      <input type="text" name="name" value="<%= values.name %>" required>
    </label>
    <label>Email
      <input type="email" name="email" value="<%= values.email %>" required>
    </label>
    <label>Age
      <input type="number" name="age" value="<%= values.age %>" min="0" step="1" required>
    </label>
    <button type="submit">Register</button>
  </form>

  <p><a href="/users">View users</a></p>
</body>
</html>
