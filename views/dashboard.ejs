<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard</title>
  <style>
    body { max-width: 720px; margin: 48px auto; padding: 0 24px; color: #1f2937; font: 16px/1.7 system-ui, sans-serif; overflow-wrap: anywhere; }
    h1 { color: #176b45; }
    a { color: #1759a6; }
  </style>
</head>
<body>
  <h1>Welcome, <%= username %>!</h1>
  <p>Session ID: <%= sessionId %></p>
  <p>Visit Count: <%= visitCount %></p>
  <p><a href="/dashboard">Refresh Dashboard</a></p>
  <p><a href="/logout">Logout</a></p>
</body>
</html>
