<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Registration Successful</title>
  <style>
    body { max-width: 640px; margin: 48px auto; padding: 0 24px; color: #1f2937; font: 16px/1.6 system-ui, sans-serif; }
